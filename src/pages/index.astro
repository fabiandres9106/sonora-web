---
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

// Components
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

// Sections
import HeroSection from "../components/HeroSection.astro";
import NosotrosSection from "../components/NosotrosSection.astro";
import ExperienciaSection from "../components/ExperienciaSection.astro";
import ClientesSection from "../components/ClientesSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
import EventosSection from "../components/EventosSection.astro";
import AliadosSection from "../components/AliadosSection.astro";

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<HeroSection />

			<!-- Nosotros Section -->
			<NosotrosSection />

			<!-- Experiencia Section -->
			<ExperienciaSection />

			<!-- Clientes Section -->
			<ClientesSection />

			<!-- Services Section -->
			<ServicesSection />

			<!-- Events Section -->
			<EventosSection />

			<!-- Aliados Section -->
			<AliadosSection />

		</main>
		<Footer />
	</body>
</html>
