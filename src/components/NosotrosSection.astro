---
import { Image } from "astro:assets";
import ButtonYellow from "../components/common/ButtonYellow.astro";

import nosotrosImg1 from "../assets/img/img1.jpg";
import nosotrosImg2 from "../assets/img/img4.jpg";
import nosotrosImg3 from "../assets/img/img16.jpg";
---

<section id="Nosotros" class="w-full items-center flex flex-col px-25 py-30">
    <div class="max-w-desktop flex items-center gap-5">
        <div id="gallery-section" class="flex justify-center w-1/2">
            <div class="card-stack w-90 h-115 cursor-pointer" id="cardStack">
                <div
                    class="photo-card absolute w-88 h-115 bg-white p-2 rounded-sm shadow-2xl transition-transform"
                    data-index="0"
                >
                    <Image
                        class="w-full h-full object-cover"
                        src={nosotrosImg1}
                        alt="SonoraImg1"
                    />
                </div>
                <div
                    class="photo-card absolute w-88 h-115 bg-white p-2 rounded-sm shadow-2xl transition-transform"
                    data-index="1"
                >
                    <Image
                        class="w-full h-full object-cover"
                        src={nosotrosImg2}
                        alt="SonoraImg1"
                    />
                </div>
                <div
                    class="photo-card absolute w-88 h-115 bg-white p-2 rounded-sm shadow-2xl transition-transform"
                    data-index="2"
                >
                    <Image
                        class="w-full h-full object-cover"
                        src={nosotrosImg3}
                        alt="SonoraImg1"
                    />
                </div>
            </div>
        </div>
        <div class="w-1/2 flex flex-col items-end justify-center gap-5">
            <div class="flex flex-col gap-1 items-end">
                <h1 class="title1 text-white">Celebremos la vida</h1>
                <h1 class="title1 text-white">Celebremos más</h1>
            </div>
            <p class="text-right text-base-text">
                <b>Somos una empresa líder en servicios para eventos</b>, pero,
                para nosotros, eso significa mucho más. Estamos convencidos de
                que podemos convertir cualquier evento en una experiencia
                sensorial poderosa, única y extraordinaria, utilizando nuestra
                experiencia y conocimiento en la industria del entretenimiento,
                las artes y la cultura. <b
                    >Desde la organización y planeación hasta la ejecución y
                    posterior evaluación, logramos que ocurran cosas increíbles.</b
                >
            </p>
            <div class="flex gap-2.5">
                <ButtonYellow href="#">Nosotros</ButtonYellow>
                <ButtonYellow href="#">Nuestra Cultura</ButtonYellow>
                <ButtonYellow href="#">Nuestro Equipo</ButtonYellow>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";

    // Gallery Nosotros Script
    const cards = Array.from(
        document.querySelectorAll(".photo-card"),
    ) as HTMLElement[];

    //Posiciones iniciales
    const states = [
        { x: -140, y: 10, rotation: -10, zIndex: 1, scale: 0.8 }, // Fondo Izquierda
        { x: 130, y: 0, rotation: 6, zIndex: 2, scale: 0.78 }, // Fondo derecha
        { x: 0, y: 0, rotation: -3, zIndex: 3, scale: 1 }, // Frente
    ];

    function updatePositions(animate = true) {
        cards.forEach((card, index) => {
            const state = states[index];

            //Asignar z-index inmediatamente
            card.style.zIndex = String(state.zIndex);

            if (animate) {
                gsap.to(card, {
                    x: state.x,
                    y: state.y,
                    rotation: state.rotation,
                    scale: state.scale,
                    duration: 0.1,
                    ease: "power2.out",
                });
            } else {
                gsap.set(card, {
                    x: state.x,
                    y: state.y,
                    rotation: state.rotation,
                    scale: state.scale,
                });
            }
        });
    }

    // Inicializar posiciones
    updatePositions(false);

    // Al hacer clic en el contenedor o en las tarjetas rotamos el array de estados
    const stack = document.getElementById("cardStack");

    // 1. Extraemos la lógica a una función reutilizable
    function rotateCards() {
        const frontState = states.pop();
        if (frontState) {
            states.unshift(frontState);
        }
        // Aplicamos posiciones con animación GSAP
        updatePositions(true);
    }

    // 2. Mantenemos el evento al hacer clic
    stack?.addEventListener("click", () => {
        rotateCards();
        resetAutoRotate(); // Opcional: reinicia el temporizador si el usuario hace clic
    });

    // 3. Ejecución periódica cada 5 segundos (5000 ms)
    let autoRotateInterval = setInterval(rotateCards, 2000);

    // 4. Función para reiniciar el temporizador
    function resetAutoRotate() {
        clearInterval(autoRotateInterval);
        autoRotateInterval = setInterval(rotateCards, 5000);
    }
</script>
