---
import { SITE_TITLE } from "../consts";
import { Icon } from "astro-icon/components";
import HeaderLink from "./HeaderLink.astro";
---

<header
	id="main-header"
	class="fixed top-0 left-0 w-full h-18 z-50 transition-all duration-300 bg-linear-to-b from-secondary/80 to-transparent p-2"
>
	<nav class="flex justify-between items-center">
		<div>
			<button
				id="menu-btn"
				aria-expanded="false"
				aria-control="main-menu"
				class="items-center menu border border-primary text-primary cursor-pointer transition-all hover:text-black hover:bg-primary"
			>
				<Icon name="material-symbols:menu" class="p-1 size-8" />
			</button>
		</div>
		<div id="social-media-links" class="flex gap-2 px-2">
			<HeaderLink
				class="social-media-links text-primary hover:text-white transition-all"
				href={`https://www.facebook.com/sonoraeventservices`}
			>
				<Icon name="streamline-logos:facebook-logo-2" class="size-5" />
			</HeaderLink>
			<HeaderLink
				class="social-media-links text-primary hover:text-white transition-all"
				href={`https://www.instagram.com/sonoraeventservices/`}
			>
				<Icon
					name="streamline-logos:instagram-logo-2-solid"
					class="size-5"
				/>
			</HeaderLink>
			<HeaderLink
				class="social-media-links text-primary hover:text-white transition-all"
				href={`https://www.tiktok.com/@sonoraes`}
			>
				<Icon name="streamline-logos:tiktok-logo" class="size-5" />
			</HeaderLink>
			<HeaderLink
				class="social-media-links text-primary hover:text-white transition-all"
				href={`https://www.tiktok.com/@sonoraes`}
			>
				<Icon name="material-symbols:mail-rounded" class="size-5" />
			</HeaderLink>
			<HeaderLink
				class="social-media-links text-primary hover:text-white transition-all"
				href={`https://www.tiktok.com/@sonoraes`}
			>
				<Icon
					name="streamline-logos:whatsapp-logo-solid"
					class="size-5"
				/>
			</HeaderLink>
		</div>
	</nav>
</header>

<script>
	function setupNavbar() {
		const header = document.getElementById("main-header");
		const menuBtn = document.getElementById("menu-btn");
		const socialLinks = document.querySelectorAll(".social-media-links");
		//const iconOpen = document.getElementById("icon-open");
		//const iconClose = document.getElementById("icon-close");

		// Detectar scroll para cambiar fondo y padding
		window.addEventListener("scroll", () => {
			const isScrolled = window.scrollY > 20;

			// Estilos header y Botón Menú
			if (isScrolled) {
				header?.classList.add("bg-primary");
				header?.classList.remove(
					"bg-transparent",
					"bg-linear-to-b",
					"from-secondary",
					"to-transparent",
					"h-18"
				);
				menuBtn?.classList.add(
					"border-secondary",
					"bg-primary",
					"text-secondary",
					"hover:bg-secondary",
					"hover:text-primary",
				);
				menuBtn?.classList.remove(
					"border-primary",
					"text-primary",
					"bg-transparent",
					"hover:text-secondary"
				);
			} else {
				header?.classList.add(
					"bg-linear-to-b",
					"from-secondary",
					"to-transparent",
					"h-18"
				);
				header?.classList.remove("bg-primary");
				menuBtn?.classList.add(
					"border-primary",
					"bg-transparent",
					"text-primary",
					"hover:bg-primary",
					"hover:text-secondary"
				);
				menuBtn?.classList.remove(
					"border-secondary",
					"text-secondary",
					"bg-primary",
					"hover:bg-secondary",
					"hover:text-primary",
				);
			}

			// Estilos listado de links HeaderLinks
			socialLinks.forEach((link) => {
				if (isScrolled) {
					link.classList.add("text-secondary", "hover:text-black");
					link.classList.remove("text-primary", "hover:text-white");
				} else {
					link.classList.add("text-primary", "hover:text-white");
					link.classList.remove("text-secondary", "hover:text-black");
				}
			});
		});

		// Toggle menú móvil
		/*
		menuBtn?.addEventListener("click", () => {
			mobileMenu?.classList.toggle("hidden");
			iconOpen?.classList.toggle("hidden");
			iconClose?.classList.toggle("hidden");
		});
		*/
	}

	// Ejecución en carga inicial y soporte para View Transitions de Astro
	setupNavbar();
	document.addEventListener("astro:after-swap", setupNavbar);
</script>

