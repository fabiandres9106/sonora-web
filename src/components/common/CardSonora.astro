---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ButtonYellow from "./ButtonYellow.astro";

import sonora_bgDefault from "../../assets/img/sonora_bgDefault.svg";

interface Props {
    title: string;
    description: string;
    href?: string;
    heroImage?: ImageMetadata;
}

const {
    title,
    description,
    href,
    heroImage = sonora_bgDefault,
} = Astro.props as Props;
---

<div class="border rounded-lg w-70 mx-2.5 lg:w-96 lg:min-w-96">
    <div>
        {
            heroImage && (
                <a class="block overflow-hidden select-none" href={href}>
                    <Image
                        class="w-full h-65 object-cover object-center rounded-t-lg scale-100 grayscale transition-all
                        hover:grayscale-0 hover:scale-105 
                        lg:h-90"
                        draggable="false"
                        src={heroImage}
                        alt={title}
                    />
                </a>
            )
        }
    </div>
    <div class="flex flex-col items-baseline p-5 gap-2.5">
        <h1
            class="font-bold uppercase bg-secondary text-white inline-block py-0.5 lg:text-xl"
        >
            {title}
        </h1>
        <p class="text-sm lg:leading-4 line-clamp-3 lg:text-sm">{description}</p>
        {href && <ButtonYellow href={href}>Más información</ButtonYellow>}
    </div>
</div>
